# Copy to .env and fill in. .env is never committed.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
LEAK_HMAC_KEY=change-me-long-random-string
LEAK_API_TOKEN=change-me-long-random-string
SEARXNG_SECRET=change-me-long-random-string
ALLOW_CLOUD_LLM=false
# cloud mode only (dev, never the demo): an OpenAI-compatible API, e.g. https://api.groq.com/openai/v1
CLOUD_API_BASE=
CLOUD_API_KEY=
CLOUD_MODEL=
# a thinking model needs room for its hidden reasoning on top of the app's budgets, e.g. 1400
CLOUD_REASONING_TOKENS=0
